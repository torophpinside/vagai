# VagAI - Environment Configuration
# Copy this file to .env and update the values

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=vagai
DB_PASSWORD=change-me-in-production
DB_NAME=vagai

# JWT Authentication
# OBRIGATÓRIO (mínimo 32 caracteres). A API se recusa a iniciar sem JWT_SECRET.
JWT_SECRET=change-me-to-a-random-secure-string-at-least-32-chars

# Redes de proxies confiáveis por trás da API (CIDRs separados por vírgula).
# Vazio = nenhum proxy confiável (X-Forwarded-For ignorado).
# TRUSTED_PROXIES=10.0.0.0/8,192.168.0.0/16

# Origens cross-origin permitidas (CORS), separadas por vírgula.
# Ex.: https://app.vagai.com
# CORS_ALLOWED_ORIGINS=https://app.vagai.com

# LM Studio AI (local LLM)
LMSTUDIO_URL=http://127.0.0.1:1234

# Redis (caching, rate limiting)
REDIS_URL=redis://localhost:6379

# Stripe (billing)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLIC_KEY=pk_test_...

# Email (Resend/SendGrid)
EMAIL_API_KEY=
EMAIL_FROM=noreply@vagai.com

# App
APP_ENV=development
APP_PORT=8080
